        {
            "key": "field_69b43bd2a0825",
            "label": "Enable AJAX sample basket",
            "name": "enable_ajax_sample_basket",
            "aria-label": "",
            "type": "true_false",
            "instructions": "Adds samples to the basket without reloading the page, and shows a sticky \"x of 3 chosen\" bar linking to the basket. Off means each sample costs a full page load and returns the visitor to the top of the page. Set per site, so it can be piloted in one market before rolling out.",
            "required": 0,
            "conditional_logic": 0,
            "wrapper": {
                "width": "",
                "class": "",
                "id": ""
            },
            "message": "",
            "default_value": 0,
            "allow_in_bindings": 0,
            "ui": 1,
            "ui_on_text": "On",
            "ui_off_text": "Off"
        },
        {
            "key": "field_69b43be3a0826",
            "label": "Sample tiles: make adding the sample the primary action",
            "name": "sample_tile_add_focus",
            "aria-label": "",
            "type": "true_false",
            "instructions": "By default the heading link is stretched across the whole sample tile, so tapping the swatch navigates to the product page rather than adding the sample. Turning this on hides the \"View product\" overlay label and hands the tile-wide tap to the sample button instead, so tapping the swatch adds it. The heading stays a normal link to the product page. Removal stays on the button, so a mis-tap cannot drop a sample. Applies only where a tile offers a single sample. Set per site.",
            "required": 0,
            "conditional_logic": 0,
            "wrapper": {
                "width": "",
                "class": "",
                "id": ""
            },
            "message": "",
            "default_value": 0,
            "allow_in_bindings": 0,
            "ui": 1,
            "ui_on_text": "On",
            "ui_off_text": "Off"
        }
