        {
            "key": "field_69b43bd2a0825",
            "label": "Enable AJAX sample basket",
            "name": "enable_ajax_sample_basket",
            "aria-label": "",
            "type": "true_false",
            "instructions": "Adds samples to the basket without reloading the page, and shows a sticky \"x of 3 chosen\" bar linking to the basket. Off means each sample costs a full page load and returns the visitor to the top of the page. Set per site, so it can be piloted in one market before rolling out.",
