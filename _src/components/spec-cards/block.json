{
    "$schema": "https://raw.githubusercontent.com/AdvancedCustomFields/schemas/main/json/block.json",
    "apiVersion": 3,
    "name": "acf/spec-cards",
    "title": "Spec Cards",
    "description": "Bordered cards with a title, image, description, key facts, document links and a button",
    "category": "granola-blocks",
    "icon": "screenoptions",
    "keywords": [
        "cards",
        "range",
        "specifier",
        "commercial"
    ],
    "acf": {
        "mode": "auto",
        "blockVersion": 3,
        "autoInlineEditing": false,
        "hideFieldsInSidebar": true,
        "renderCallback": "\\Granola\\Component::acf_render_callback"
    },
    "supports": {
        "anchor": true,
        "align": false,
        "color": {
            "background": true,
            "text": false
        },
        "mode": false
    }
}
