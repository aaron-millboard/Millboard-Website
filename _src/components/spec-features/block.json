{
    "$schema": "https://raw.githubusercontent.com/AdvancedCustomFields/schemas/main/json/block.json",
    "apiVersion": 3,
    "name": "acf/spec-features",
    "title": "Spec Features",
    "description": "Checklist of features with an icon, title, text and an optional link",
    "category": "granola-blocks",
    "icon": "list-view",
    "keywords": [
        "features",
        "checklist",
        "icons",
        "specifier"
    ],
    "acf": {
        "mode": "auto",
        "blockVersion": 3,
        "autoInlineEditing": false,
        "hideFieldsInSidebar": true,
        "renderCallback": "\\Granola\\Component::acf_render_callback"
    },
    "supports": {
        "anchor": true,
        "align": false,
        "color": {
            "background": true,
            "text": false
        },
        "mode": false
    }
}
