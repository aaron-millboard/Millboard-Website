{
    "key": "group_spec_system_block",
    "title": "Block - Spec System",
    "fields": [
        {
            "key": "field_spec_system_preheading",
            "type": "text",
            "name": "preheading",
            "label": "Pre-heading"
        },
        {
            "key": "field_spec_system_heading",
            "type": "text",
            "name": "heading",
            "label": "Heading",
            "required": 1
        },
        {
            "key": "field_spec_system_content",
            "type": "wysiwyg",
            "name": "content",
            "label": "Description",
            "toolbar": "basic",
            "media_upload": 0,
            "tabs": "all"
        },
        {
            "key": "field_spec_system_image",
            "type": "image",
            "name": "image",
            "label": "Image",
            "return_format": "id",
            "preview_size": "medium",
            "library": "all"
        },
        {
            "key": "field_spec_system_media_side",
            "type": "select",
            "name": "media_side",
            "label": "Image side",
            "choices": {
                "left": "Left",
                "right": "Right"
            },
            "default_value": "left",
            "return_format": "value",
            "allow_null": 0
        },
        {
            "key": "field_spec_system_facts",
            "type": "repeater",
            "name": "facts",
            "label": "Key facts",
            "layout": "block",
            "button_label": "Add fact",
            "sub_fields": [
                {
                    "key": "field_spec_system_facts_label",
                    "type": "text",
                    "name": "label",
                    "label": "Label",
                    "parent_repeater": "field_spec_system_facts"
                },
                {
                    "key": "field_spec_system_facts_value",
                    "type": "text",
                    "name": "value",
                    "label": "Value",
                    "parent_repeater": "field_spec_system_facts"
                }
            ],
            "max": 8
        },
        {
            "key": "field_spec_system_buttons",
            "type": "repeater",
            "name": "buttons",
            "label": "Buttons",
            "layout": "block",
            "button_label": "Add button",
            "sub_fields": [
                {
                    "key": "field_spec_system_buttons_button",
                    "type": "link",
                    "name": "button",
                    "label": "Link",
                    "return_format": "array",
                    "parent_repeater": "field_spec_system_buttons"
                }
            ],
            "max": 3,
            "instructions": "The first is the outlined button, the rest are text buttons."
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/spec-system"
            }
        ]
    ]
}
