{
    "key": "block_page_header",
    "title": "Block - Page Header",
    "fields": [
        {
            "key": "block_page_header_tab_content",
            "label": "Header Content",
            "type": "tab"
        },
        {
            "key": "block_page_header_source",
            "label": "Content source",
            "name": "source",
            "type": "select",
            "choices": {
                "current": "Current page/post",
                "post": "Featured Post",
                "custom": "Custom content (page layout)"
            }
        },
        {
            "key": "block_page_header_object",
            "label": "Select post",
            "name": "object",
            "type": "post_object",
            "post_type": [
                "post",
                "page",
                "case-study"
            ],
            "conditional_logic": [
                [
                    {
                        "field": "block_page_header_source",
                        "operator": "==",
                        "value": "post"
                    }
                ]
            ]
        },
        {
            "key": "block_page_header_preheading",
            "label": "Preheading",
            "name": "preheading",
            "type": "text",
            "conditional_logic": [
                [
                    {
                        "field": "block_page_header_source",
                        "operator": "!=",
                        "value": "post"
                    }
                ]
            ]
        },
        {
            "key": "block_page_header_heading",
            "label": "Heading",
            "name": "heading",
            "type": "text",
            "conditional_logic": [
                [
                    {
                        "field": "block_page_header_source",
                        "operator": "==",
                        "value": "custom"
                    }
                ]
            ]
        },
        {
            "key": "block_page_header_description",
            "label": "Description",
            "name": "description",
            "type": "wysiwyg",
            "media_upload": 0,
            "tabs": "all",
            "toolbar": "basic",
            "conditional_logic": [
                [
                    {
                        "field": "block_page_header_source",
                        "operator": "!=",
                        "value": "post"
                    }
                ]
            ]
        },
        {
            "key": "block_page_header_cta",
            "label": "Call to Action",
            "name": "cta",
            "type": "link",
            "return_format": "array",
            "conditional_logic": [
                [
                    {
                        "field": "block_page_header_source",
                        "operator": "!=",
                        "value": "post"
                    }
                ]
            ]
        },
        {
            "key": "block_page_header_tab_settings",
            "label": "Settings",
            "type": "tab"
        },
        {
            "key": "block_page_header_bg_gradient",
            "label": "Add gradient to background?",
            "name": "bg_gradient",
            "type": "true_false"
        },
        {
            "key": "block_page_header_image",
            "label": "Image",
            "name": "image",
            "type": "image",
            "return_format": "array",
            "conditional_logic": [
                [
                    {
                        "field": "block_page_header_source",
                        "operator": "==",
                        "value": "custom"
                    }
                ]
            ]
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf\/page-header"
            }
        ]
    ]
}
