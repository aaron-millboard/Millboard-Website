{
    "key": "block_page_header",
    "title": "Block - Page Header",
    "fields": [
        {
            "key": "block_page_header_tab_content",
            "label": "Header Content",
            "type": "tab"
        },
        {
            "key": "block_page_header_source",
            "label": "Content source",
            "name": "source",
            "type": "select",
            "choices": {
                "current": "Current page/post",
                "post": "Featured Post",
                "custom": "Custom content (page layout)"
            }
        },
        {
            "key": "block_page_header_object",
            "label": "Select post",
            "name": "object",
            "type": "post_object",
            "post_type": [
                "post",
                "page",
                "case-study"
            ],
            "conditional_logic": [
                [
                    {
                        "field": "block_page_header_source",
                        "operator": "==",
                        "value": "post"
                    }
                ]
            ]
        },
        {
            "key": "block_page_header_preheading",
            "label": "Preheading",
            "name": "preheading",
            "type": "text",
            "conditional_logic": [
                [
                    {
                        "field": "block_page_header_source",
                        "operator": "!=",
                        "value": "post"
                    }
                ]
            ]
        },
        {
            "key": "block_page_header_heading",
            "label": "Heading",
            "name": "heading",
            "type": "text",
            "conditional_logic": [
                [
                    {
                        "field": "block_page_header_source",
                        "operator": "!=",
                        "value": "post"
                    }
                ]
            ]
        },
        {
            "key": "block_page_header_description",
            "label": "Description",
            "name": "description",
            "type": "wysiwyg",
            "media_upload": 0,
            "tabs": "all",
            "toolbar": "basic",
            "conditional_logic": [
                [
                    {
                        "field": "block_page_header_source",
                        "operator": "!=",
                        "value": "post"
                    }
                ]
            ]
        },
        {
            "key": "block_page_header_cta",
            "label": "Call to Action",
            "name": "cta",
            "type": "link",
            "return_format": "array",
            "conditional_logic": [
                [
                    {
                        "field": "block_page_header_source",
                        "operator": "!=",
                        "value": "post"
                    }
                ]
            ]
        },
        {
            "key": "block_page_header_tab_settings",
            "label": "Settings",
            "type": "tab"
        },
        {
            "key": "block_page_header_layout",
            "label": "Layout",
            "name": "layout",
            "type": "select",
            "instructions": "Applies to pages only. Article, case study and product headers always use the classic layout.",
            "choices": {
                "editorial": "Full-bleed editorial - image behind the whole header",
                "split": "Split plate - text panel, image to the right",
                "classic": "Classic - heading crosses the image"
            },
            "default_value": "editorial",
            "return_format": "value",
            "allow_null": 0,
            "multiple": 0,
            "ui": 0
        },
        {
            "key": "block_page_header_background_video",
            "label": "Background video",
            "name": "background_video",
            "type": "file",
            "instructions": "Optional, and only used by the editorial and split layouts. Upload a short, silent MP4 (H.264). It plays muted on a loop with a pause button, and the header image is used as its poster frame and its fallback, so an image must be set as well. Keep the file under about 5MB so it does not slow the page down.",
            "return_format": "array",
            "mime_types": "mp4,webm,m4v",
            "library": "all",
            "conditional_logic": [
                [
                    {
                        "field": "block_page_header_layout",
                        "operator": "!=",
                        "value": "classic"
                    }
                ]
            ]
        },
        {
            "key": "block_page_header_bg_gradient",
            "label": "Add gradient to background?",
            "name": "bg_gradient",
            "type": "true_false"
        },
        {
            "key": "block_page_header_image",
            "label": "Image",
            "name": "image",
            "type": "image",
            "return_format": "array",
            "conditional_logic": [
                [
                    {
                        "field": "block_page_header_source",
                        "operator": "==",
                        "value": "custom"
                    }
                ]
            ]
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf\/page-header"
            }
        ]
    ]
}
