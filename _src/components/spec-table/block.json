{
    "$schema": "https://raw.githubusercontent.com/AdvancedCustomFields/schemas/main/json/block.json",
    "apiVersion": 3,
    "name": "acf/spec-table",
    "title": "Spec Table",
    "description": "Specification table: heading row and rows of cells, any cell can be a link",
    "category": "granola-blocks",
    "icon": "editor-table",
    "keywords": [
        "table",
        "compare",
        "specification",
        "specifier"
    ],
    "acf": {
        "mode": "auto",
        "blockVersion": 3,
        "autoInlineEditing": false,
        "hideFieldsInSidebar": true,
        "renderCallback": "\\Granola\\Component::acf_render_callback"
    },
    "supports": {
        "anchor": true,
        "align": false,
        "color": {
            "background": true,
            "text": false
        },
        "mode": false
    }
}
