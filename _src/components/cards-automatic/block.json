{
    "$schema": "https://raw.githubusercontent.com/AdvancedCustomFields/schemas/main/json/block.json",
    "apiVersion": 3,
    "name": "acf/cards-automatic",
    "title": "Cards Automatic",
    "category": "granola-blocks",
    "description": "Use to present content from the rest of the site as cards. For instance, recent posts, or a selected list of posts.",
    "icon": "tide",
    "keywords": [
        "cards",
        "automatic",
        "custom"
    ],
    "acf": {
        "mode": "auto",
        "blockVersion": 3,
        "autoInlineEditing": false,
        "hideFieldsInSidebar": false,
        "renderCallback": "\\Granola\\Component::acf_render_callback"
    },
    "supports": {
        "align": [
            "wide",
            "full",
            "center"
        ],
        "anchor": true,
        "color": {
            "text": false
        },
        "mode": false
    },
    "attributes": {
        "align": {
            "type": "string",
            "default": "wide"
        }
    }
}
