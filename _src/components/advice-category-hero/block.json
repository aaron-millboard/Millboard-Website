{
    "$schema": "https://raw.githubusercontent.com/AdvancedCustomFields/schemas/main/json/block.json",
    "apiVersion": 3,
    "name": "acf/advice-category-hero",
    "title": "Advice Category Hero",
    "description": "The advice category opener: breadcrumbs, H1, intro, live guide and topic counts, then a full-width photograph.",
    "category": "granola-blocks",
    "icon": "cover-image",
    "keywords": [
        "advice",
        "category",
        "hero"
    ],
    "acf": {
        "mode": "edit",
        "blockVersion": 3,
        "autoInlineEditing": false,
        "hideFieldsInSidebar": true,
        "renderCallback": "\\Granola\\Component::acf_render_callback",
        "postTypes": [
            "page",
            "granola-template"
        ]
    },
    "supports": {
        "align": false,
        "anchor": true,
        "color": {
            "background": false,
            "text": false
        },
        "mode": false,
        "multiple": false
    },
    "attributes": {
        "align": {
            "type": "string",
            "default": "full"
        }
    }
}
