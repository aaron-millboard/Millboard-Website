                            "label": "Label",
                            "parent_repeater": "field_spec_projects_cards_details"
                        },
                        {
                            "key": "field_spec_projects_cards_details_value",
                            "type": "text",
                            "name": "value",
                            "label": "Value",
                            "parent_repeater": "field_spec_projects_cards_details"
