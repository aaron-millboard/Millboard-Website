{
    "key": "group_spec_projects_block",
    "title": "Block - Spec Projects",
    "fields": [
        {
            "key": "field_spec_projects_preheading",
            "type": "text",
            "name": "preheading",
            "label": "Pre-heading"
        },
        {
            "key": "field_spec_projects_heading",
            "type": "text",
            "name": "heading",
            "label": "Heading"
        },
        {
            "key": "field_spec_projects_link",
            "type": "link",
            "name": "link",
            "label": "Link",
