{
    "$schema": "https://raw.githubusercontent.com/AdvancedCustomFields/schemas/main/json/block.json",
    "apiVersion": 3,
    "name": "acf/home-hero",
    "title": "Home Hero",
    "description": "Full-screen film that opens from an inset frame to full bleed as the page scrolls, with the strapline rising letter by letter.",
    "category": "granola-blocks",
    "icon": "format-video",
    "keywords": [ "hero", "film", "video", "homepage" ],
    "acf": {
        "mode": "edit",
        "blockVersion": 3,
        "autoInlineEditing": false,
        "hideFieldsInSidebar": false,
        "renderCallback": "\\Granola\\Component::acf_render_callback",
        "postTypes": [
            "page",
            "granola-template"
        ]
    },
    "supports": {
        "align": false,
        "anchor": true,
        "color": {
            "background": false,
            "text": false
        },
        "mode": false,
        "multiple": false
    },
    "attributes": {
        "align": {
            "type": "string",
            "default": "full"
        }
    }
}
