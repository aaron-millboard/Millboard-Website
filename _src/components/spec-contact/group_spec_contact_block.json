{
    "key": "group_spec_contact_block",
    "title": "Block - Spec Contact",
    "fields": [
        {
            "key": "field_spec_contact_preheading",
            "type": "text",
            "name": "preheading",
            "label": "Pre-heading"
        },
        {
            "key": "field_spec_contact_heading",
            "type": "text",
            "name": "heading",
            "label": "Heading",
            "required": 1
        },
        {
            "key": "field_spec_contact_content",
            "type": "wysiwyg",
            "name": "content",
            "label": "Text",
            "toolbar": "basic",
            "media_upload": 0,
            "tabs": "all"
        },
        {
            "key": "field_spec_contact_person_image",
            "type": "image",
            "name": "person_image",
            "label": "Adviser photo",
            "return_format": "id",
            "preview_size": "medium",
            "library": "all"
        },
        {
            "key": "field_spec_contact_person_name",
            "type": "text",
            "name": "person_name",
            "label": "Adviser name"
        },
        {
            "key": "field_spec_contact_person_role",
            "type": "text",
            "name": "person_role",
            "label": "Adviser role and phone",
            "instructions": "For example \"Specification adviser · 024 7643 9943\"."
        },
        {
            "key": "field_spec_contact_note",
            "type": "textarea",
            "name": "note",
            "label": "Note under the adviser",
            "rows": 2,
            "new_lines": "",
            "instructions": "For example the response time."
        },
        {
            "key": "field_spec_contact_hs_form_id",
            "type": "text",
            "name": "hs_form_id",
            "label": "HubSpot form ID",
            "instructions": "The form is embedded inline and takes the site form styling."
        },
        {
            "key": "field_spec_contact_hs_portal_id",
            "type": "text",
            "name": "hs_portal_id",
            "label": "HubSpot portal ID",
            "default_value": "26853518"
        },
        {
            "key": "field_spec_contact_hs_region",
            "type": "text",
            "name": "hs_region",
            "label": "HubSpot region",
            "default_value": "eu1"
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/spec-contact"
            }
        ]
    ]
}
