{
    "$schema": "https://raw.githubusercontent.com/AdvancedCustomFields/schemas/main/json/block.json",
    "apiVersion": 3,
    "name": "acf/home-reasons",
    "title": "Home Reasons Grid",
    "description": "A headed grid of short reasons, each with a line icon.",
    "category": "granola-blocks",
    "icon": "screenoptions",
    "keywords": [
        "reasons",
        "why",
        "homepage",
        "features"
    ],
    "acf": {
        "mode": "edit",
        "blockVersion": 3,
        "autoInlineEditing": false,
        "hideFieldsInSidebar": true,
        "renderCallback": "\\Granola\\Component::acf_render_callback",
        "postTypes": [
            "page",
            "granola-template"
        ]
    },
    "supports": {
        "align": false,
        "anchor": true,
        "color": {
            "background": false,
            "text": false
        },
        "mode": false,
        "multiple": true
    },
    "attributes": {
        "align": {
            "type": "string",
            "default": "full"
        }
    }
}
