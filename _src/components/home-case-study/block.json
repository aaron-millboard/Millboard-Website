{
    "$schema": "https://raw.githubusercontent.com/AdvancedCustomFields/schemas/main/json/block.json",
    "apiVersion": 3,
    "name": "acf/home-case-study",
    "title": "Home Featured Case Study",
    "description": "A full-bleed project photograph with the headline and a route into the case study.",
    "category": "granola-blocks",
    "icon": "cover-image",
    "keywords": [
        "case study",
        "featured",
        "homepage",
        "project"
    ],
    "acf": {
