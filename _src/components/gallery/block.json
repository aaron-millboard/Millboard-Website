{
    "$schema": "https://raw.githubusercontent.com/AdvancedCustomFields/schemas/main/json/block.json",
    "apiVersion": 2,
    "name": "acf/gallery",
    "title": "Gallery",
    "category": "granola-blocks",
    "icon": "images-alt",
    "keywords": [
        "images",
        "slider",
        "carousel",
        "lightbox"
    ],
    "acf": {
        "mode": "auto",
        "renderCallback": "\\Granola\\Component::acf_render_callback"
    },
    "supports": {
        "anchor": true,
        "align": false,
        "color": {
            "text": false,
            "background": false
        },
        "mode": false
    },
    "attributes": {
        "align": {
            "type": "string",
            "default": "full"
        }
    }
}
