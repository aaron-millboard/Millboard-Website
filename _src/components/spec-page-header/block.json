{
    "$schema": "https://raw.githubusercontent.com/AdvancedCustomFields/schemas/main/json/block.json",
    "apiVersion": 3,
    "name": "acf/spec-page-header",
    "title": "Spec Page Header",
    "description": "Specifier page header: preheading, heading, description, image and up to three calls to action (primary, secondary, text link)",
    "category": "granola-blocks",
    "icon": "align-pull-left",
    "keywords": [
        "header",
        "hero",
        "specifier",
        "commercial"
    ],
    "acf": {
        "mode": "auto",
        "blockVersion": 3,
        "autoInlineEditing": false,
        "hideFieldsInSidebar": true,
        "renderCallback": "\\Granola\\Component::acf_render_callback"
    },
    "supports": {
        "anchor": true,
        "align": false,
        "color": {
            "background": true,
            "text": false
        },
        "mode": false
    }
}
